---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Không tìm thấy trang - Lê Thu Giang" description="Trang chị tìm không có hoặc đã được chuyển đi.">
  <main id="main" class="wrap notfound">
    <p class="notfound-code">404</p>
    <h1>Trang này đã đi đâu mất rồi</h1>
    <p class="lead">Có thể đường dẫn bị gõ sai, hoặc bài viết đã được chuyển sang chỗ mới. Chị quay về trang chủ để đọc tiếp nhé.</p>
    <div class="actions">
      <a href="/" class="btn btn-primary">Về trang chủ</a>
      <a href="/#moi-nhat" class="btn btn-ghost">Xem bài mới nhất</a>
    </div>
  </main>
</Layout>
