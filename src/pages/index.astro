---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <a class="skip" href="#main">Bỏ qua tới nội dung</a>

  <!-- ================= HEADER ================= -->
  <header>
    <div class="wrap nav">
      <a href="/" class="logo" aria-label="Trang chủ Lê Thu Giang"><span class="logo-dot">G</span>Thu Giang</a>
      <ul class="menu" id="menu">
        <li><a href="#" aria-current="page">Trang chủ</a></li>
        <li><a href="#chu-de">Chăm da</a></li>
        <li><a href="#chu-de">Nám &amp; sạm</a></li>
        <li><a href="#chu-de">Lối sống</a></li>
        <li><a href="#chu-de">Góc tâm sự</a></li>
        <li><a href="#ve-giang">Giới thiệu</a></li>
      </ul>
      <div class="nav-right">
        <button class="icon-btn" aria-label="Tìm kiếm">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        </button>
        <button class="icon-btn theme-toggle" id="themeToggle" aria-label="Chuyển giao diện sáng tối">
          <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
          <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
        <button class="icon-btn menu-btn" id="menuBtn" aria-label="Mở menu" aria-expanded="false" aria-controls="menu">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </button>
      </div>
    </div>
  </header>

  <main id="main">
    <!-- ================= HERO ================= -->
    <div class="wrap hero">
      <div class="reveal">
        <span class="greet"><span id="greetIcon">☀</span> <span id="greetText">Chào chị, chúc một ngày dịu dàng</span></span>
        <h1>Hiểu da, chọn đúng,<br><em>làm đủ.</em></h1>
        <p class="lead">Kiến thức chăm sóc da khoa học, dễ áp dụng tại nhà cho phụ nữ bận rộn. Không thần tốc, không chạy theo trend, chỉ là hiểu mình hơn mỗi ngày.</p>
        <div class="actions">
          <a href="#moi-nhat" class="btn btn-primary">Bắt đầu đọc
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <a href="#lo-trinh" class="btn btn-ghost">Lộ trình cho người mới</a>
        </div>
      </div>
      <div class="hero-art reveal" aria-hidden="true">
        <svg viewBox="0 0 400 400">
          <circle cx="300" cy="96" r="54" fill="var(--gold)" opacity=".85"/>
          <rect x="60" y="210" width="280" height="130" rx="24" fill="var(--accent-soft)"/>
          <rect x="110" y="120" width="70" height="170" rx="20" fill="var(--accent)"/>
          <rect x="124" y="98" width="42" height="32" rx="8" fill="var(--text)"/>
          <rect x="210" y="170" width="86" height="120" rx="22" fill="var(--green)"/>
          <rect x="226" y="150" width="54" height="26" rx="8" fill="var(--text)"/>
          <circle cx="145" cy="210" r="16" fill="var(--bg)" opacity=".7"/>
          <path d="M226 230h54" stroke="var(--bg)" stroke-width="6" stroke-linecap="round" opacity=".7"/>
          <path d="M60 340h280" stroke="var(--line)" stroke-width="3"/>
          <circle cx="76" cy="90" r="8" fill="var(--blue)"/>
          <circle cx="340" cy="240" r="6" fill="var(--accent)"/>
        </svg>
      </div>
    </div>

    <!-- ================= NỔI BẬT ================= -->
    <section class="wrap">
      <div class="sec-head reveal">
        <div><h2>Bài nổi bật</h2><p>Những bài được chị em đọc và lưu lại nhiều nhất</p></div>
      </div>
      <div class="featured">
        <a href="#" class="card big reveal">
          <div class="thumb" style="background:var(--gold-soft)">
            <svg viewBox="0 0 100 100"><circle cx="50" cy="50" r="38" fill="var(--gold)" opacity=".25"/><circle cx="50" cy="50" r="24" fill="var(--gold)"/><circle cx="40" cy="44" r="4" fill="var(--gold-soft)"/><circle cx="58" cy="56" r="6" fill="var(--gold-soft)"/></svg>
          </div>
          <div class="card-body">
            <span><span class="tag t-nam">Nám &amp; sạm</span></span>
            <h3>Nám da là gì? Nguyên nhân và cách chăm sóc an toàn tại nhà</h3>
            <p>Hiểu đúng cơ chế hình thành nám trước khi chọn bất kỳ sản phẩm nào. Bài nền tảng nên đọc đầu tiên nếu chị đang lo về nám.</p>
            <div class="meta"><span>12 phút đọc</span><span>Bài nền tảng</span></div>
          </div>
        </a>
        <div class="side">
          <a href="#" class="card reveal">
            <div class="thumb" style="background:var(--accent-soft)">
              <svg viewBox="0 0 100 100"><path d="M50 14c18 22 28 36 28 50a28 28 0 0 1-56 0c0-14 10-28 28-50z" fill="var(--accent)"/></svg>
            </div>
            <div class="card-body">
              <span><span class="tag t-nam">Nám &amp; sạm</span></span>
              <h3>7 sai lầm khiến nám càng trị càng đậm</h3>
              <div class="meta"><span>8 phút đọc</span></div>
            </div>
          </a>
          <a href="#" class="card reveal">
            <div class="thumb" style="background:var(--blue-soft)">
              <svg viewBox="0 0 100 100"><circle cx="50" cy="50" r="20" fill="var(--blue)"/><g stroke="var(--blue)" stroke-width="6" stroke-linecap="round"><path d="M50 12v10M50 78v10M12 50h10M78 50h10M23 23l7 7M70 70l7 7M23 77l7-7M70 30l7-7"/></g></svg>
            </div>
            <div class="card-body">
              <span><span class="tag t-skin">Chăm da</span></span>
              <h3>Chống nắng đúng cách cho làn da đang bị nám</h3>
              <div class="meta"><span>7 phút đọc</span></div>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- ================= CHỦ ĐỀ ================= -->
    <section class="wrap" id="chu-de">
      <div class="sec-head reveal"><div><h2>Khám phá theo chủ đề</h2><p>Chọn điều chị đang quan tâm</p></div></div>
      <div class="topics">
        <a href="#" class="topic reveal" style="color:var(--accent)">
          <div class="ic" style="background:var(--accent-soft)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 3c4 5 6 8 6 11a6 6 0 0 1-12 0c0-3 2-6 6-11z"/></svg></div>
          <h3>Chăm da cơ bản</h3><p>Làm sạch, dưỡng ẩm, chống nắng và cách đọc bảng thành phần.</p><small>24 bài viết</small>
        </a>
        <a href="#" class="topic reveal" style="color:var(--gold)">
          <div class="ic" style="background:var(--gold-soft)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="8"/><circle cx="10" cy="10" r="1.5" fill="currentColor"/><circle cx="14.5" cy="14" r="2" fill="currentColor"/></svg></div>
          <h3>Nám &amp; sạm màu</h3><p>Nám nội tiết, nám sau sinh, hoạt chất làm sáng an toàn.</p><small>18 bài viết</small>
        </a>
        <a href="#" class="topic reveal" style="color:var(--green)">
          <div class="ic" style="background:var(--green-soft)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 19c0-8 5-13 14-14-1 9-6 14-14 14z"/><path d="M5 19l7-7"/></svg></div>
          <h3>Lối sống kỷ luật</h3><p>Giấc ngủ, ăn uống, vận động và thói quen nhỏ mỗi ngày.</p><small>15 bài viết</small>
        </a>
        <a href="#" class="topic reveal" style="color:var(--blue)">
          <div class="ic" style="background:var(--blue-soft)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M12 20s-7-4.5-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.5-7 10-7 10z"/></svg></div>
          <h3>Góc tâm sự</h3><p>Yêu mình từ bên trong, sống chậm và tự tin hơn.</p><small>12 bài viết</small>
        </a>
      </div>
    </section>

    <!-- ================= LỘ TRÌNH ================= -->
    <section class="wrap" id="lo-trinh">
      <div class="path reveal">
        <div class="sec-head"><div><h2>Mới bắt đầu? Đi theo 3 bước này</h2><p>Lộ trình Giang gợi ý cho người chưa biết bắt đầu từ đâu</p></div></div>
        <div class="steps">
          <div class="step"><h3>Hiểu da</h3><p>Xác định loại da, tình trạng da và điều làn da của chị đang cần.</p><a href="#">Da bạn thuộc loại nào? →</a></div>
          <div class="step"><h3>Chọn đúng</h3><p>Biết đọc thành phần, hiểu hoạt chất để không mua theo quảng cáo.</p><a href="#">Cẩm nang hoạt chất →</a></div>
          <div class="step"><h3>Làm đủ</h3><p>Một quy trình tối giản, làm đều mỗi ngày và kiên nhẫn với kết quả.</p><a href="#">Quy trình 3 bước tối giản →</a></div>
        </div>
      </div>
    </section>

    <!-- ================= MỚI NHẤT ================= -->
    <section class="wrap" id="moi-nhat">
      <div class="sec-head reveal">
        <div><h2>Bài mới nhất</h2><p>Cập nhật mỗi tuần</p></div>
        <a href="#" class="more">Xem tất cả →</a>
      </div>
      <div class="grid-3">
        <a href="#" class="card reveal">
          <div class="thumb" style="background:var(--gold-soft)"><svg viewBox="0 0 100 100"><circle cx="38" cy="42" r="18" fill="var(--gold)"/><rect x="48" y="48" width="34" height="34" rx="10" fill="var(--accent)"/></svg></div>
          <div class="card-body"><span><span class="tag t-nam">Nám &amp; sạm</span></span>
            <h3>Nám sau sinh và nám nội tiết: vì sao da sạm đi sau khi làm mẹ</h3>
            <p>Thay đổi nội tiết ảnh hưởng tới sắc tố da như thế nào, và điều gì nên chờ đợi.</p>
            <div class="meta"><span>20/11/2026</span><span>10 phút đọc</span></div></div>
        </a>
        <a href="#" class="card reveal">
          <div class="thumb" style="background:var(--accent-soft)"><svg viewBox="0 0 100 100"><rect x="30" y="16" width="40" height="68" rx="14" fill="var(--accent)"/><rect x="38" y="30" width="24" height="6" rx="3" fill="var(--accent-soft)"/></svg></div>
          <div class="card-body"><span><span class="tag t-skin">Chăm da</span></span>
            <h3>Các hoạt chất làm sáng nám an toàn: nên bắt đầu từ đâu</h3>
            <p>Niacinamide, vitamin C, tranexamic acid, arbutin: hiểu từng loại trước khi dùng.</p>
            <div class="meta"><span>16/11/2026</span><span>9 phút đọc</span></div></div>
        </a>
        <a href="#" class="card reveal">
          <div class="thumb" style="background:var(--green-soft)"><svg viewBox="0 0 100 100"><path d="M64 22a30 30 0 1 0 14 40A24 24 0 0 1 64 22z" fill="var(--green)"/><circle cx="72" cy="28" r="4" fill="var(--green)"/></svg></div>
          <div class="card-body"><span><span class="tag t-life">Lối sống</span></span>
            <h3>Ngủ đủ, da đẹp: giấc ngủ ảnh hưởng tới làn da ra sao</h3>
            <p>Vài thói quen nhỏ trước giờ ngủ giúp da phục hồi tốt hơn mà không tốn kém.</p>
            <div class="meta"><span>12/11/2026</span><span>6 phút đọc</span></div></div>
        </a>
        <a href="#" class="card reveal">
          <div class="thumb" style="background:var(--blue-soft)"><svg viewBox="0 0 100 100"><path d="M50 80s-26-16-26-36a14 14 0 0 1 26-8 14 14 0 0 1 26 8c0 20-26 36-26 36z" fill="var(--blue)"/></svg></div>
          <div class="card-body"><span><span class="tag t-heart">Góc tâm sự</span></span>
            <h3>Chăm sóc bản thân không phải là ích kỷ</h3>
            <p>Người phụ nữ hiểu mình và yêu mình mới đủ sức gánh những điều còn lại.</p>
            <div class="meta"><span>08/11/2026</span><span>5 phút đọc</span></div></div>
        </a>
        <a href="#" class="card reveal">
          <div class="thumb" style="background:var(--soft)"><svg viewBox="0 0 100 100"><rect x="20" y="24" width="60" height="52" rx="12" fill="var(--muted)" opacity=".35"/><path d="M32 42h36M32 54h24" stroke="var(--text)" stroke-width="6" stroke-linecap="round"/></svg></div>
          <div class="card-body"><span><span class="tag t-skin">Chăm da</span></span>
            <h3>Cách đọc bảng thành phần mỹ phẩm trong 5 phút</h3>
            <p>Mẹo nhận biết thành phần chính, chất dễ kích ứng và những lời quảng cáo cần cảnh giác.</p>
            <div class="meta"><span>04/11/2026</span><span>7 phút đọc</span></div></div>
        </a>
        <a href="#" class="card reveal">
          <div class="thumb" style="background:var(--green-soft)"><svg viewBox="0 0 100 100"><circle cx="50" cy="50" r="30" fill="none" stroke="var(--green)" stroke-width="8"/><path d="M50 32v18l12 8" stroke="var(--green)" stroke-width="8" stroke-linecap="round" fill="none"/></svg></div>
          <div class="card-body"><span><span class="tag t-life">Lối sống</span></span>
            <h3>Kiên nhẫn với làn da: vì sao cần ít nhất 28 ngày</h3>
            <p>Chu kỳ tái tạo da và lý do không nên đổi sản phẩm liên tục.</p>
            <div class="meta"><span>31/10/2026</span><span>6 phút đọc</span></div></div>
        </a>
      </div>
    </section>

    <!-- ================= FAQ ================= -->
    <section class="wrap">
      <div class="faq-wrap">
        <div class="reveal">
          <h2 style="font-size:28px;letter-spacing:-.02em;line-height:1.3">Hỏi nhanh, đáp gọn</h2>
          <p style="color:var(--muted);margin-top:10px">Những câu chị em hỏi Giang nhiều nhất. Chưa thấy câu của chị? Gửi cho Giang nhé.</p>
          <a href="#" class="btn btn-ghost" style="margin-top:22px">Gửi câu hỏi</a>
        </div>
        <div class="reveal">
          <details open><summary>Nám có trị dứt điểm được không?</summary><p>Nám là tình trạng dễ tái phát, nên mục tiêu thực tế là kiểm soát và làm mờ bền vững, không phải "hết vĩnh viễn". Chống nắng đều và kiên nhẫn quan trọng hơn bất kỳ sản phẩm nào.</p></details>
          <details><summary>Mới bắt đầu thì cần những bước nào?</summary><p>Ba bước là đủ: làm sạch dịu nhẹ, dưỡng ẩm phù hợp và chống nắng mỗi sáng. Thêm hoạt chất khi da đã ổn định.</p></details>
          <details><summary>Bao lâu thì thấy sản phẩm có tác dụng?</summary><p>Thường từ 4 đến 8 tuần, tương ứng 1 đến 2 chu kỳ tái tạo da. Đổi sản phẩm liên tục sẽ khiến chị không biết cái gì thật sự hợp.</p></details>
          <details><summary>Khi nào cần đi khám bác sĩ da liễu?</summary><p>Khi da kích ứng kéo dài, nám lan rộng nhanh, hoặc đã chăm đúng cách vài tháng mà không cải thiện. Blog chỉ mang tính tham khảo, không thay thế chẩn đoán y khoa.</p></details>
        </div>
      </div>
    </section>

    <!-- ================= VỀ GIANG ================= -->
    <section class="wrap" id="ve-giang">
      <div class="about reveal">
        <div class="avatar" aria-hidden="true">
          <!-- Thay bằng ảnh thật: <img src="giang.jpg" alt="Lê Thu Giang"> -->
          <svg viewBox="0 0 100 100"><circle cx="50" cy="38" r="18" fill="var(--accent)"/><path d="M18 92c2-20 16-30 32-30s30 10 32 30z" fill="var(--accent)"/></svg>
        </div>
        <div>
          <span class="tag t-skin">Về Giang</span>
          <blockquote>"Giang không hứa trắng thần tốc. Giang chỉ muốn chị hiểu làn da của mình hơn một chút."</blockquote>
          <p>Mình là Lê Thu Giang, người đồng hành cùng phụ nữ bận rộn trên hành trình chăm sóc bản thân từ bên trong. Mình chia sẻ kiến thức chăm da khoa học, đơn giản, làm được tại nhà, cùng những câu chuyện về lối sống kỷ luật và yêu thương chính mình.</p>
          <div class="pledges"><span>Giải thích khoa học dễ hiểu</span><span>Không thổi phồng</span><span>Không chạy theo trend</span></div>
          <a href="#" class="more" style="display:inline-block;margin-top:22px">Đọc câu chuyện của Giang →</a>
        </div>
      </div>
    </section>

    <!-- ================= NEWSLETTER ================= -->
    <section class="wrap">
      <div class="news reveal">
        <h2>Một lá thư nhỏ mỗi sáng Chủ nhật</h2>
        <p>Một kiến thức chăm da, một thói quen tốt và một lời nhắn yêu thương. Đọc trong 3 phút.</p>
        <form onsubmit="event.preventDefault(); this.querySelector('button').textContent='Cảm ơn chị!';">
          <label for="email" class="skip">Email</label>
          <input id="email" type="email" placeholder="Email của chị" required>
          <button type="submit">Nhận thư</button>
        </form>
        <small>Không spam. Hủy bất cứ lúc nào.</small>
      </div>
    </section>
  </main>

  <!-- ================= FOOTER ================= -->
  <footer>
    <div class="wrap">
      <div class="foot">
        <div>
          <a href="/" class="logo"><span class="logo-dot">G</span>Thu Giang</a>
          <p>Chăm sóc da khoa học và lối sống kỷ luật cho phụ nữ bận rộn. Hiểu da, chọn đúng, làm đủ.</p>
        </div>
        <div><h4>Chủ đề</h4><ul><li><a href="#">Chăm da cơ bản</a></li><li><a href="#">Nám &amp; sạm màu</a></li><li><a href="#">Lối sống</a></li><li><a href="#">Góc tâm sự</a></li></ul></div>
        <div><h4>Blog</h4><ul><li><a href="#">Giới thiệu</a></li><li><a href="#">Lộ trình người mới</a></li><li><a href="#">Hỏi đáp</a></li><li><a href="#">Liên hệ</a></li></ul></div>
        <div><h4>Kết nối</h4><ul><li><a href="#">Facebook</a></li><li><a href="#">TikTok</a></li><li><a href="#">YouTube</a></li><li><a href="#">Zalo</a></li></ul></div>
      </div>
      <div class="disclaimer">
        <span>© 2026 Lê Thu Giang. Nội dung mang tính tham khảo, không thay thế tư vấn của bác sĩ da liễu.</span>
        <span id="themeNote"></span>
      </div>
    </div>
  </footer>


  <script is:inline>
    (function () {
      var root = document.documentElement;
      var btn = document.getElementById('themeToggle');
      var note = document.getElementById('themeNote');
      var hour = new Date().getHours();
      var tz = '';
      try { tz = Intl.DateTimeFormat().resolvedOptions().timeZone; } catch (e) {}

      function autoTheme() { var h = new Date().getHours(); return (h >= 6 && h < 18) ? 'light' : 'dark'; }
      function saved() { try { return localStorage.getItem('theme'); } catch (e) { return null; } }
      function render() {
        var t = root.getAttribute('data-theme');
        btn.setAttribute('aria-label', t === 'dark' ? 'Chuyển sang giao diện sáng' : 'Chuyển sang giao diện tối');
        note.textContent = saved()
          ? 'Giao diện ' + (t === 'dark' ? 'tối' : 'sáng') + ' (chị đã chọn)'
          : 'Giao diện tự động theo giờ' + (tz ? ' ' + tz : '');
      }

      // Nút chuyển: bấm để đổi và ghi nhớ; nếu chọn trùng chế độ tự động thì quay lại chế độ tự động
      btn.addEventListener('click', function () {
        var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        try {
          if (next === autoTheme()) localStorage.removeItem('theme');
          else localStorage.setItem('theme', next);
        } catch (e) {}
        render();
      });

      // Khi chưa chọn tay: kiểm tra mỗi phút để đổi giao diện lúc 6h và 18h
      setInterval(function () {
        if (!saved()) { root.setAttribute('data-theme', autoTheme()); render(); }
      }, 60000);
      render();

      // Lời chào theo buổi
      var g = hour < 11 ? ['☀', 'Chào buổi sáng, chị ơi'] :
              hour < 14 ? ['☀', 'Chào buổi trưa, nhớ uống đủ nước nhé'] :
              hour < 18 ? ['☁', 'Chào buổi chiều, nghỉ tay một chút nhé'] :
                          ['☾', 'Chào buổi tối, đã đến giờ chăm da rồi'];
      document.getElementById('greetIcon').textContent = g[0];
      document.getElementById('greetText').textContent = g[1];

      // Menu di động
      var menuBtn = document.getElementById('menuBtn');
      var menu = document.getElementById('menu');
      menuBtn.addEventListener('click', function () {
        var open = menu.classList.toggle('open');
        menuBtn.setAttribute('aria-expanded', open);
      });
      menu.addEventListener('click', function (e) {
        if (e.target.tagName === 'A') { menu.classList.remove('open'); menuBtn.setAttribute('aria-expanded', 'false'); }
      });

      // Hiệu ứng hiện dần khi cuộn
      var els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); } });
        }, { threshold: 0.12 });
        els.forEach(function (el) { io.observe(el); });
      } else { els.forEach(function (el) { el.classList.add('in'); }); }
    })();
  </script>
</Layout>
