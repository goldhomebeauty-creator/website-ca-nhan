---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import TheBai from '../components/TheBai.astro';
import { CHU_DE, KENH, chiBaiDang, type MaChuDe } from '../lib/bai';
import anhGhe from '../assets/anh/giang-ghe-sofa.webp';
import anhChanDung from '../assets/anh/giang-chan-dung.webp';

// Mọi thẻ trên trang chủ lấy từ bài thật trong src/content/bai, không còn thẻ giả.
const ds = chiBaiDang(await getCollection('bai'));
// Bài nổi bật: bài cũ nhất (bài nền tảng) làm thẻ lớn
const noiBat = [...ds.filter((b) => b.data.noiBat).reverse(), ...ds].filter((b, i, arr) => arr.findIndex((x) => x.id === b.id) === i).slice(0, 3);
const moiNhat = ds.filter((b) => !noiBat.some((n) => n.id === b.id)).slice(0, 6);
const soBai = (ma: MaChuDe) => ds.filter((b) => b.data.chuDe === ma).length;
const coBai = (id: string) => ds.some((b) => b.id === id);
// Lộ trình 3 bước: trỏ tới bài thật, chưa có bài thì trỏ về trang chủ đề
const loTrinh = [
  { ten: 'Hiểu da', moTa: 'Xác định loại da, tình trạng da và điều làn da của chị đang cần.', link: 'da-thuoc-loai-nao', nhan: 'Da chị thuộc loại nào? →', duPhong: '/chu-de/cham-da/' },
  { ten: 'Chọn đúng', moTa: 'Biết đọc thành phần, hiểu hoạt chất để không mua theo quảng cáo.', link: 'cach-doc-bang-thanh-phan-my-pham', nhan: 'Cách đọc bảng thành phần →', duPhong: '/chu-de/cham-da/' },
  { ten: 'Làm đủ', moTa: 'Một quy trình tối giản, làm đều mỗi ngày và kiên nhẫn với kết quả.', link: 'quy-trinh-cham-da-3-buoc-toi-gian', nhan: 'Quy trình 3 bước tối giản →', duPhong: '/chu-de/cham-da/' },
].map((x) => ({ ...x, href: coBai(x.link) ? `/bai/${x.link}/` : x.duPhong }));
const ICON: Record<MaChuDe, { mau: string; nen: string; svg: string }> = {
  'cham-da': { mau: 'var(--accent)', nen: 'var(--accent-soft)', svg: '<path d="M12 3c4 5 6 8 6 11a6 6 0 0 1-12 0c0-3 2-6 6-11z"/>' },
  'nam-sam': { mau: 'var(--gold)', nen: 'var(--gold-soft)', svg: '<circle cx="12" cy="12" r="8"/><circle cx="10" cy="10" r="1.5" fill="currentColor"/><circle cx="14.5" cy="14" r="2" fill="currentColor"/>' },
  'loi-song': { mau: 'var(--green)', nen: 'var(--green-soft)', svg: '<path d="M5 19c0-8 5-13 14-14-1 9-6 14-14 14z"/><path d="M5 19l7-7"/>' },
  'song-khoe': { mau: 'var(--teal)', nen: 'var(--teal-soft)', svg: '<path d="M3 20l6-10 4 6 3-4 5 8z"/><circle cx="17" cy="6" r="2"/>' },
  'goc-tam-su': { mau: 'var(--blue)', nen: 'var(--blue-soft)', svg: '<path d="M12 20s-7-4.5-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.5-7 10-7 10z"/>' },
};
---

<Layout current="home">

  <main id="main">
    <!-- ================= HERO ================= -->
    <div class="wrap hero">
      <div class="reveal">
        <span class="greet"><span id="greetIcon">☀</span> <span id="greetText">Chào chị, chúc một ngày dịu dàng</span></span>
        <h1>Hiểu da, chọn đúng,<br><em>làm đủ.</em></h1>
        <p class="lead">Kiến thức chăm sóc da khoa học, dễ áp dụng tại nhà cho phụ nữ bận rộn. Không thần tốc, không chạy theo trend, chỉ là hiểu mình hơn mỗi ngày.</p>
        <div class="actions">
          <a href="#moi-nhat" class="btn btn-primary">Bắt đầu đọc
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <a href="#lo-trinh" class="btn btn-ghost">Lộ trình cho người mới</a>
        </div>
      </div>
      <div class="hero-art reveal">
        <span class="hero-blob" aria-hidden="true"></span>
        <Image src={anhGhe} alt="Lê Thu Giang ngồi trên ghế bành, áo trắng" widths={[420, 640, 900]} sizes="(max-width: 960px) 420px, 520px" loading="eager" fetchpriority="high" />
      </div>
    </div>

    <!-- ================= NỔI BẬT ================= -->
    <section class="wrap">
      <div class="sec-head reveal">
        <div><h2>Bài nổi bật</h2><p>Những bài nền tảng Giang khuyên chị đọc trước</p></div>
      </div>
      <div class="featured">
        {noiBat[0] && <TheBai bai={noiBat[0]} co="big" />}
        {noiBat.length > 1 && (
          <div class="side">
            {noiBat.slice(1).map((b) => <TheBai bai={b} co="side" />)}
          </div>
        )}
      </div>
    </section>

    <!-- ================= CHỦ ĐỀ ================= -->
    <section class="wrap" id="chu-de">
      <div class="sec-head reveal"><div><h2>Khám phá theo chủ đề</h2><p>Chọn điều chị đang quan tâm</p></div></div>
      <div class="topics">
        {(Object.keys(CHU_DE) as MaChuDe[]).map((ma) => (
          <a href={`/chu-de/${ma}/`} class="topic reveal" style={`color:${ICON[ma].mau}`}>
            <div class="ic" style={`background:${ICON[ma].nen}`}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ICON[ma].svg} /></div>
            <h3>{CHU_DE[ma].tenDai}</h3><p>{CHU_DE[ma].gioiThieu.split('.')[0]}.</p><small>{soBai(ma) > 0 ? `${soBai(ma)} bài viết` : 'Sắp có bài'}</small>
          </a>
        ))}
      </div>
    </section>

    <!-- ================= LỘ TRÌNH ================= -->
    <section class="wrap" id="lo-trinh">
      <div class="path reveal">
        <div class="sec-head"><div><h2>Mới bắt đầu? Đi theo 3 bước này</h2><p>Lộ trình Giang gợi ý cho người chưa biết bắt đầu từ đâu</p></div></div>
        <div class="steps">
          {loTrinh.map((x) => <div class="step"><h3>{x.ten}</h3><p>{x.moTa}</p><a href={x.href}>{x.nhan}</a></div>)}
        </div>
      </div>
    </section>

    <!-- ================= MỚI NHẤT ================= -->
    <section class="wrap" id="moi-nhat">
      <div class="sec-head reveal">
        <div><h2>Bài mới nhất</h2><p>Cập nhật mỗi tuần</p></div>
        <a href="/bai/" class="more">Xem tất cả →</a>
      </div>
      <div class="grid-3">
        {moiNhat.map((b) => <TheBai bai={b} />)}
      </div>
    </section>

    <!-- ================= FAQ ================= -->
    <section class="wrap" id="hoi-dap">
      <div class="faq-wrap">
        <div class="reveal">
          <h2 style="font-size:28px;letter-spacing:-.02em;line-height:1.3">Hỏi nhanh, đáp gọn</h2>
          <p style="color:var(--muted);margin-top:10px">Những câu chị em hỏi Giang nhiều nhất. Chưa thấy câu của chị? Gửi cho Giang nhé.</p>
          <a href={KENH.messenger} class="btn btn-ghost" style="margin-top:22px" target="_blank" rel="noopener">Gửi câu hỏi cho Giang</a>
        </div>
        <div class="reveal">
          <details open><summary>Nám có trị dứt điểm được không?</summary><p>Nám là tình trạng dễ tái phát, nên mục tiêu thực tế là kiểm soát và làm mờ bền vững, không phải "hết vĩnh viễn". Chống nắng đều và kiên nhẫn quan trọng hơn bất kỳ sản phẩm nào.</p></details>
          <details><summary>Mới bắt đầu thì cần những bước nào?</summary><p>Ba bước là đủ: làm sạch dịu nhẹ, dưỡng ẩm phù hợp và chống nắng mỗi sáng. Thêm hoạt chất khi da đã ổn định.</p></details>
          <details><summary>Bao lâu thì thấy sản phẩm có tác dụng?</summary><p>Thường từ 4 đến 8 tuần, tương ứng 1 đến 2 chu kỳ tái tạo da. Đổi sản phẩm liên tục sẽ khiến chị không biết cái gì thật sự hợp.</p></details>
          <details><summary>Khi nào cần đi khám bác sĩ da liễu?</summary><p>Khi da kích ứng kéo dài, nám lan rộng nhanh, hoặc đã chăm đúng cách vài tháng mà không cải thiện. Blog chỉ mang tính tham khảo, không thay thế chẩn đoán y khoa.</p></details>
        </div>
      </div>
    </section>

    <!-- ================= VỀ GIANG ================= -->
    <section class="wrap" id="ve-giang">
      <div class="about reveal">
        <div class="avatar">
          <Image src={anhChanDung} alt="Chân dung Lê Thu Giang" widths={[260, 400, 640]} sizes="(max-width: 820px) 220px, 320px" />
        </div>
        <div>
          <span class="tag t-skin">Về Giang</span>
          <blockquote>"Giang không hứa trắng thần tốc. Giang chỉ muốn chị hiểu làn da của mình hơn một chút."</blockquote>
          <p>Mình là Lê Thu Giang, người đồng hành cùng phụ nữ bận rộn trên hành trình chăm sóc bản thân từ bên trong. Mình chia sẻ kiến thức chăm da khoa học, đơn giản, làm được tại nhà, cùng những câu chuyện về lối sống kỷ luật và yêu thương chính mình.</p>
          <div class="pledges"><span>Giải thích khoa học dễ hiểu</span><span>Không thổi phồng</span><span>Không chạy theo trend</span></div>
          <a href="/ve-giang/" class="more" style="display:inline-block;margin-top:22px">Đọc thêm về Giang →</a>
        </div>
      </div>
    </section>

    <!-- ================= NEWSLETTER ================= -->
    <section class="wrap">
      <div class="news reveal">
        <h2>Theo dõi Giang mỗi ngày</h2>
        <p>Video chăm da mới trên YouTube, chia sẻ nhỏ trên Facebook. Có câu hỏi riêng thì nhắn thẳng cho Giang.</p>
        <div class="actions" style="justify-content:center">
          <a href={KENH.youtube} class="btn btn-primary" target="_blank" rel="noopener">Kênh YouTube</a>
          <a href={KENH.facebook} class="btn btn-ghost" target="_blank" rel="noopener">Facebook</a>
          <a href={KENH.zalo} class="btn btn-ghost" target="_blank" rel="noopener">Zalo</a>
        </div>
      </div>
    </section>
  </main>

  <script is:inline>
    // Lời chào theo buổi trong ngày (giờ địa phương của người xem)
    (function () {
      var hour = new Date().getHours();
      var g = hour < 11 ? ['☀', 'Chào buổi sáng, chị ơi'] :
              hour < 14 ? ['☀', 'Chào buổi trưa, nhớ uống đủ nước nhé'] :
              hour < 18 ? ['☁', 'Chào buổi chiều, nghỉ tay một chút nhé'] :
                          ['☾', 'Chào buổi tối, đã đến giờ chăm da rồi'];
      document.getElementById('greetIcon').textContent = g[0];
      document.getElementById('greetText').textContent = g[1];
    })();
  </script>
</Layout>
