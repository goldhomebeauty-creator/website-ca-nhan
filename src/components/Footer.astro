---
import Logo from './Logo.astro';
import { CHU_DE, KENH } from '../lib/bai';
---
<!-- ================= FOOTER ================= -->
<footer>
  <div class="wrap">
    <div class="foot">
      <div>
        <a href="/" class="logo" aria-label="Trang chủ Lê Thu Giang"><Logo id="chan" tagline={false} /></a>
        <p>Chăm sóc da khoa học và lối sống kỷ luật cho phụ nữ bận rộn. Hiểu da, chọn đúng, làm đủ.</p>
      </div>
      <div><h4>Chủ đề</h4><ul>{Object.entries(CHU_DE).map(([ma, c]) => <li><a href={`/chu-de/${ma}/`}>{c.tenDai}</a></li>)}</ul></div>
      <div><h4>Blog</h4><ul><li><a href="/ve-giang/">Giới thiệu</a></li><li><a href="/bai/">Tất cả bài viết</a></li><li><a href="/#lo-trinh">Lộ trình người mới</a></li><li><a href="/#hoi-dap">Hỏi đáp</a></li><li><a href={KENH.messenger} target="_blank" rel="noopener">Liên hệ</a></li></ul></div>
      <div><h4>Kết nối</h4><ul><li><a href={KENH.facebook} target="_blank" rel="noopener">Facebook</a></li><li><a href={KENH.youtube} target="_blank" rel="noopener">YouTube</a></li><li><a href={KENH.zalo} target="_blank" rel="noopener">Zalo</a></li><li><a href={KENH.messenger} target="_blank" rel="noopener">Messenger</a></li></ul></div>
    </div>
    <div class="disclaimer">
      <span>© 2026 Lê Thu Giang. Nội dung mang tính tham khảo, không thay thế tư vấn của bác sĩ da liễu.</span>
      <span id="themeNote"></span>
    </div>
  </div>
</footer>
