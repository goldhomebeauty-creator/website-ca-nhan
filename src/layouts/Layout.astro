---
interface Props {
	title?: string;
}
const { title = 'Website cá nhân' } = Astro.props;
---

<!doctype html>
<html lang="vi">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	body {
		font-family: system-ui, sans-serif;
		max-width: 720px;
		margin: 60px auto;
		padding: 0 20px;
		line-height: 1.6;
		color: #222;
	}
	h1 {
		margin-bottom: 4px;
	}
</style>
